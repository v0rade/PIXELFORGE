# ==============================================================================
# PIXELFORGE — Creative Asset Studio
# Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# SECURITY WARNING:
# - Never commit `.env` or `.env.local` to version control.
# - Variables prefixed with `NEXT_PUBLIC_` are exposed to the browser.
# - Keep `SUPABASE_SERVICE_ROLE_KEY` and `RESEND_API_KEY` strictly server-only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Origin & Canonical URL
# ------------------------------------------------------------------------------
# Local development: http://localhost:3000
# Production (Vercel): https://your-pixelforge-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Database, Auth & Private Storage)
# ------------------------------------------------------------------------------
# Leave blank to run in zero-config Local Studio Fallback Mode.
# Populate from Supabase Dashboard -> Project Settings -> API:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY: Used only in trusted server route handlers / admin tasks.
# NEVER prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Optional Transactional Email Provider (Notifications & Invitations)
# ------------------------------------------------------------------------------
# PIXELFORGE never pretends to send emails when no provider is configured.
# Configure either Resend OR SMTP to enable outbound transactional emails:
RESEND_API_KEY=
EMAIL_FROM=notifications@pixelforge.studio

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# 4. Operational & Logging Configuration
# ------------------------------------------------------------------------------
LOG_LEVEL=info
